# Copy to .env and fill in. Never commit .env.

# ---- LLM (natural-language -> ticket fields) ----
# Provider: openai | groq | gemini | heuristic
# "heuristic" needs no key and uses rule-based extraction (good for local dev/tests).
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL override.
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=

# ---- ManageEngine ServiceDesk Plus REST API (v3) ----
# Cloud example:   https://sdpondemand.manageengine.com/app/itdesk
# On-prem example: https://servicedesk.internal:8080
SDP_BASE_URL=
SDP_API_PATH=/api/v3/requests
# Technician API key (on-prem) or OAuth access token (cloud).
SDP_AUTH_TOKEN=
SDP_DEFAULT_SITE=
SDP_DEFAULT_CATEGORY=

# ---- Telegram Bot API ----
TELEGRAM_BOT_TOKEN=

# ---- WhatsApp (Meta Cloud API) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token you set in the Meta webhook config; echoed back during GET verification.
WHATSAPP_VERIFY_TOKEN=verify-me

REQUEST_TIMEOUT=30
